# Headers served by Cloudflare Workers (static assets).
#
# CSP: no inline script is generated (see
# integrations/externalize-inline-scripts.mjs), hence "script-src 'self'".
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # "no-transform" tells Cloudflare not to rewrite the responses: it must not
  # inject its own inline script (JavaScript detections), which the CSP blocks.
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Content-hashed file names → long, immutable cache.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

# The demo request pages load the Turnstile widget (script and frame from
# challenges.cloudflare.com): the CSP is widened for these pages only.
/demo*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
/en/demo*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
