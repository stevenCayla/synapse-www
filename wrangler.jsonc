// Cloudflare Workers hosting (static assets, no server-side code).
//   wrangler deploy --env=""   → production: synapse-medical.fr             (main branch)
//   wrangler deploy --env dev  → staging:    dev-www.synapse-medical.fr (develop branch)
// Security and cache headers: public/_headers (copied into dist/ at build time).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synapse-www",
  "compatibility_date": "2026-09-01",
  // worker-mailer opens the SMTP connection with the node:* compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  // The Worker only handles /api/*: every other request is served by the static assets
  // (and unknown addresses by the 404 page).
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Public settings. Secrets (TURNSTILE_SECRET_KEY, SMTP_USERNAME, SMTP_TOKEN) are never
  // written here: see README.md. Variables are not inherited by "env.dev".
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "DEMO_RECIPIENT": "demo@synapse-medical.fr",
    "DEMO_SENDER": "demo@synapse-medical.fr",
    "DEMO_SEND": "smtp"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "synapse-medical.fr", "custom_domain": true }],
  "env": {
    "dev": {
      "vars": {
        "TURNSTILE_SITE_KEY": "",
        "DEMO_RECIPIENT": "demo@synapse-medical.fr",
        "DEMO_SENDER": "demo@synapse-medical.fr",
        // No real e-mail from dev-www until the Proton settings are checked.
        "DEMO_SEND": "dry-run"
      },
      "routes": [{ "pattern": "dev-www.synapse-medical.fr", "custom_domain": true }]
    }
  }
}
