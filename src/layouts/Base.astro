---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/pages.css';
import Cookie from '../components/Cookie.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Search from '../components/Search.astro';
import Sprite from '../components/Sprite.astro';
import { tr, type Lang } from '../i18n';
import { UI } from '../i18n/ui';
import { metaOf, OG_KEY } from '../i18n/meta';
import { path, type RouteKey } from '../i18n/routes';
import { SITE } from '../site';

interface Props {
  lang: Lang;
  /** Route of the page; drives the canonical URL, the hreflang links and the active menu item. */
  route: RouteKey | 'nf';
  id?: string;
  /** Overrides for the pages that are not in the route table (404). */
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Extra structured data (JSON-LD) objects. */
  ld?: Record<string, unknown>[];
}
const { lang, route, id, noindex = false, ld = [] } = Astro.props;
const [metaTitle, metaDesc] = metaOf(route, lang, id);
const title = Astro.props.title ?? metaTitle;
const description = Astro.props.description ?? metaDesc;

// The 404 page has no canonical URL nor alternates: it is served for any unknown address.
const notFound = route === 'nf';
const at = (l: Lang) => path(notFound ? 'home' : (route as RouteKey), l, id);
const canonical = SITE + at(lang);
const frUrl = SITE + at('fr');
const enUrl = SITE + at('en');
const altHref = at(lang === 'fr' ? 'en' : 'fr');
const ogImage = `${SITE}/og-image.png`;
const ogLocale = lang === 'en' ? 'en_GB' : 'fr_FR';

const ORG = { '@type': 'Organization', '@id': `${SITE}/#org`, name: 'Synapse Medical', url: `${SITE}/` };
const graph = [ORG, ...ld];
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {(noindex || notFound) && <meta name="robots" content="noindex" />}
    {!notFound && <link rel="canonical" href={canonical} />}
    {!notFound && <link rel="alternate" hreflang="fr" href={frUrl} />}
    {!notFound && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!notFound && <link rel="alternate" hreflang="x-default" href={frUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Synapse Medical" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    <script is:inline src="/theme.js"></script>
  </head>
  <body class="is-home" data-page={route} data-og={(!notFound && OG_KEY[route as RouteKey]) || 'home'}>
    <a class="skip" href="#main" data-skip>{tr(lang, UI.skip)}</a>
    <Sprite />
    <Header lang={lang} route={route} altHref={altHref} />
    <main id="main" class={`page on ${route}`} tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <Search lang={lang} />
    <Cookie lang={lang} />
    <a class="btn pri mcta" href={path('demo', lang)}>
      <span>{tr(lang, UI.demo)}</span>
      <svg class="i" aria-hidden="true"><use href="#i-arrow"></use></svg>
    </a>
    <script>
      import '../scripts/core';
      import '../scripts/net';
      import '../scripts/search';
      import '../scripts/cookies';
    </script>
  </body>
</html>
