---
import Minimal from '../layouts/Minimal.astro';
import { demoPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const fr = lang === 'fr';
const t = (f: string, e: string) => (fr ? f : e);
const required = t('Champ obligatoire', 'Required field');
const paths = { fr: demoPath('fr'), en: demoPath('en') };
---

<Minimal
  lang={lang}
  localized
  paths={paths}
  title={t('Demander une démo — Synapse Medical', 'Request a demo — Synapse Medical')}
  description={t('Demandez une démonstration de Synapse, la solution EDC pour vos études cliniques.', 'Request a demo of Synapse, the EDC solution for your clinical studies.')}
>
  <div class="hero-wrap pg-hero" style="min-height:calc(100dvh - 54px)">
    <div class="bg-anim" aria-hidden="true"><canvas class="net"></canvas></div>
    <div class="demo-wrap">
      <div class="demo-in">
        <h1 set:html={t('Demander une <em>démo.</em>', 'Request a <em>demo.</em>')} />
        <p class="lede">{t('Laissez-nous vos coordonnées : nous vous recontactons pour organiser une démonstration de Synapse.', 'Leave us your details: we will get back to you to arrange a demonstration of Synapse.')}</p>
        <div class="fcard" id="demo-card">
          <p>{t('Les champs marqués * sont obligatoires.', 'Fields marked * are required.')}</p>
          <form id="demo-f" class="fgrid" novalidate data-lang={lang} aria-describedby="demo-status">
            <label class="fld full" data-req><span>{t('Nom complet', 'Full name')} <span class="req" aria-hidden="true">*</span></span>
              <input name="name" autocomplete="name" required maxlength="120" aria-describedby="err-name" />
              <span class="err" id="err-name">{required}</span>
            </label>
            <label class="fld full" data-req><span>{t('Établissement', 'Organisation')} <span class="req" aria-hidden="true">*</span></span>
              <input name="organisation" autocomplete="organization" required maxlength="160" aria-describedby="err-organisation" />
              <span class="err" id="err-organisation">{required}</span>
            </label>
            <label class="fld full" data-req><span>{t('E-mail professionnel', 'Work email')} <span class="req" aria-hidden="true">*</span></span>
              <input name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="err-email" />
              <span class="err" id="err-email">{t('Adresse e-mail invalide', 'Invalid email address')}</span>
            </label>
            <label class="fld full"><span>{t('Téléphone (facultatif)', 'Phone (optional)')}</span>
              <input name="phone" type="tel" autocomplete="tel" maxlength="30" aria-describedby="err-phone" />
              <span class="err" id="err-phone">{t('Numéro de téléphone invalide', 'Invalid phone number')}</span>
            </label>
            <!-- Honeypot: invisible to people and to assistive technologies, robots fill it. -->
            <div class="hp" aria-hidden="true">
              <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <div class="fld full">
              <div id="demo-turnstile" data-lang={lang}></div>
            </div>
            <div class="fsub">
              <button class="btn pri" type="submit" id="demo-send" disabled>{t('Envoyer ma demande', 'Send my request')}<svg class="i" aria-hidden="true"><use href="#i-arrow"></use></svg></button>
              <small>{t('Vos informations sont envoyées par e-mail à notre équipe et ne sont pas enregistrées sur ce site.', 'Your details are sent by email to our team and are not stored on this site.')}</small>
            </div>
            <p class="demo-status full" id="demo-status" role="status" aria-live="polite"></p>
          </form>
          <noscript><p class="demo-status">{t('Ce formulaire nécessite JavaScript. Écrivez-nous à', 'This form needs JavaScript. Write to us at')} <a href="mailto:demo@synapse-medical.fr">demo@synapse-medical.fr</a>.</p></noscript>
        </div>
      </div>
    </div>
  </div>
  <script>
    import '../scripts/demo';
  </script>
</Minimal>
